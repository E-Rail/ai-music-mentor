# OpenAI-compatible Chat Completions provider.
# Copy this file to .env and keep the real credential out of Git.
# MENTOR_API_BASE may be a /v1 base URL or the full /chat/completions URL.
MENTOR_API_BASE=https://openrouter.ai/api/v1
MENTOR_API_KEY=replace-with-your-server-side-api-key
# Chosen on measurement, not reputation. Against the app's own schemas, the
# explanation, the chat reply and the exercise plan all return in under 2.1s
# worst case on Cerebras; deepseek-v4-flash took 34.5s for the explanation alone
# and returned a plan its own schema rejected. Re-measure before changing it:
#   .venv/bin/python scripts/bench_mentor_models.py
MENTOR_MODEL=openai/gpt-oss-120b
# json_schema is preferred when the selected model supports structured output.
# Other supported modes: json_object | prompt_json
MENTOR_RESPONSE_MODE=json_schema
# The mentor explains numbers that are already computed, so private deliberation
# buys nothing and costs twice: tokens nobody reads, then a truncated answer to
# re-ask. "none" is the default and is worth 5s of first-token time. gpt-oss
# cannot switch it off and rejects "none", so it gets the cheapest level it has.
MENTOR_REASONING_EFFORT=low
MENTOR_CONNECT_TIMEOUT_SECONDS=8
# Ten times the measured worst case. Long enough never to cut off a real answer,
# short enough that a hung host reaches the local explanation while a student is
# still watching rather than after they have given up.
MENTOR_READ_TIMEOUT_SECONDS=25
# Legacy combined timeout; read timeout above takes precedence.
MENTOR_TIMEOUT_SECONDS=25
# Reasoning tokens are charged against this ceiling, so a plan that needs 900
# tokens of JSON can still be cut off at 1600. Measured: 1600 truncated an
# exercise plan and cost a wasted call; 4000 answers first time.
MENTOR_MAX_OUTPUT_TOKENS=4000

# OpenRouter serves one model from many hosts whose speed differs by tens of
# seconds. Pin hosts you have actually measured; asking for a generic "fastest"
# made things worse here. Both of these are in the fast tier, so losing the
# first one costs a little speed rather than the whole latency budget.
MENTOR_PROVIDER_ORDER=cerebras,groq
# Naming a host now pins it. Left on, `order` is only a preference and
# OpenRouter routes past it freely — measured with baidu pinned, calls came back
# from StreamLake three times slower. Set true to prefer rather than pin; with
# no host named, fallbacks stay on regardless.
#   MENTOR_PROVIDER_ALLOW_FALLBACKS=true

# Reading a photographed or scanned page of music into notes. Needs a model that
# accepts images; it falls back to the mentor's credentials above, so setting
# MENTOR_API_KEY is usually enough.
#   VISION_API_BASE / VISION_API_KEY   only if the reader lives somewhere else
VISION_MODEL=xiaomi/mimo-v2.5
# Measured here: sending this model a JSON Schema made the upstream host time
# out on every attempt, while plain JSON mode answered in 8-40s. The shape is
# pinned by the prompt and enforced when the answer comes back.
VISION_TIMEOUT_SECONDS=180
VISION_MAX_PAGES=2
VISION_PAGE_PIXELS=1600
