# What Cloud Build does NOT need uploaded. Mirrors .dockerignore: the build
# context should be the same set of files wherever the image is built.
#
# Without this, gcloud falls back to .gitignore, which would send the 62 MB of
# model weights on every deploy — weights the build downloads for itself anyway.
.git
.github
.DS_Store
**/.DS_Store

# The real credentials. They reach the service as configuration set at deploy
# time, never as a layer in the image.
.env
.env.*
data

.venv
**/__pycache__
**/.pytest_cache
node_modules
**/node_modules
.pnpm-store
apps/web/dist
apps/web/test-results
apps/web/playwright-report

# Fetched during the build.
apps/web/public/models

# Rendered takes used only by the transcription audit, which runs on a
# developer's machine rather than in the container.
apps/web/public/fixtures/audio
