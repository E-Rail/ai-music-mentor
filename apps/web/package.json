{
  "name": "ai-music-mentor-web",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "copy:audio-assets": "node scripts/copy-basic-pitch-assets.mjs",
    "predev": "pnpm copy:audio-assets",
    "dev": "vite",
    "prebuild": "pnpm copy:audio-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest:e2e": "pnpm copy:audio-assets",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs-backend-cpu": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "@tensorflow/tfjs-core": "3.21.0",
    "@tonejs/midi": "^2.0.28",
    "opensheetmusicdisplay": "^1.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  }
}
